#include <stdio.h>

int main() {
    int choice;
    double num1, num2;

    printf("Enter two numbers: ");
    scanf("%lf %lf", &num1, &num2);

    printf("\n--- Arithmetic Operations Menu ---\n");
    printf("1. Addition (+)\n");
    printf("2. Subtraction (-)\n");
    printf("3. Multiplication (*)\n");
    printf("4. Division (/)\n");
    printf("5. Modulo (%%) [integers only]\n");
    printf("Enter your choice (1-5): ");
    scanf("%d", &choice);

    switch (choice) {
        case 1:
            printf("Addition is=%.2lf\n", num1 + num2);
            break;

        case 2:
            printf("Subtraction is=%.2lf\n", num1 - num2);
            break;

        case 3:
            printf("Multiplication is=%.2lf\n", num1 * num2);
            break;

        case 4:
            if (num2 != 0) {
                printf("Division is=%.2lf\n", num1 / num2);
            } else {
                printf("Error: Division by zero is not allowed.\n");
            }
            break;

        case 5: {
            int a = (int)num1;
            int b = (int)num2;
            if (b != 0) {
                printf("Remainder is=%d\n", a % b);
            } else {
                printf("Error: Modulo by zero is not allowed.\n");
            }
            break;
        }

        default:
            printf("Invalid choice! Please select an option between 1 and 5.\n");
            break;
    }

    return 0;
}
